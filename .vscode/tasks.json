{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Python with I/O",
      "type": "shell",
      "command": "python \"${file}\" < \"${fileDirname}\\input.txt\" > \"${fileDirname}\\output.txt\"",
      "options": {
        "cwd": "${fileDirname}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}